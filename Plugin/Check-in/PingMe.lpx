#!name = PingMe&WeTalk
#!desc = PingMe跟WeTalk每日签到，支持多账号。分流指定到包含所有节点的round-robin策略组。多账号使用方法：打开获取token开关登录不同的账号，点击我的页面。⚠️不要从app里面直接退出登录，卸载app重新安装，登录另一个需要签到的账号，以此类推
#!date = 2026-4-16
#!author = 怎么肥事[https://t.me/Nzmgs] luckyday[https://t.me/blessedday_bot]
#!icon = https://raw.githubusercontent.com/axhani/icon/refs/heads/main/pingme&wetalk.png
#!loon_version = 3.2.4(787)

[Argument]
arg1 = switch,true,false,tag=PingMe任务
arg2 = switch,true,false,tag=WeTalk任务
arg3 = switch,true,false,tag=PM'token
arg4 = switch,true,false,tag=WT'token
arg5 = input,"0 8,20 * * *",tag=PM定时
arg6 = input,"30 8,20 * * *",tag=WT定时

[Rule]
DOMAIN, api.pingmeapp.net, PROXY

[Script]
cron ${arg5} then script("https://luckyday.kdns.fr/refs/heads/main/Script%20/Tasks/PingMe.js") with enable=${arg1}, tag="PingMe签到任务", timeout=600
cron ${arg6} then script("https://luckyday.kdns.fr/refs/heads/main/Script%20/Tasks/WeTalk.js") with enable=${arg2}, tag="WeTalk签到任务", timeout=600
request if ${url} ~= /^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus/i then script("https://luckyday.kdns.fr/refs/heads/main/Script%20/Tasks/PingMe.js") with enable=${arg3}, tag="PingMe（token）", timeout=300
request if ${url} ~= /^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus/i then script("https://luckyday.kdns.fr/refs/heads/main/Script%20/Tasks/WeTalk.js") with enable=${arg4}, tag="WeTalk（token）", timeout=300

[MITM]
hostname = api.pingmeapp.net, api.wetalkapp.com