#!name=IP 纯净度检测
#!desc=多源节点 IP 纯净度检测（IPPure + IPLogs + ip-api），请先在参数内选择策略组。
#!category=网络检测

[Rule]
# 确保检测请求走选定的代理策略
DOMAIN-SUFFIX,ippure.com,PROXY
DOMAIN-SUFFIX,iplogs.com,PROXY
DOMAIN-SUFFIX,ip-api.com,PROXY
DOMAIN-SUFFIX,cleanip.io,PROXY
DOMAIN-SUFFIX,ip.cx,PROXY

[Script]
generic script-path=https://raw.githubusercontent.com/Tartarus2014/Loon-Script/refs/heads/master/JS/IPPure.js, timeout=15, tag=IPPure, img-url=globe.asia.australia.system