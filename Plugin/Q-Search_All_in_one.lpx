#!name= 超级搜索
#!desc=Safari 内输入格式命令快速指定搜索实现 搜索、翻译、社区、购物、视频、苹果商店切区 等功能，使用方法请查看主页
#!author= 秦城二院彭医生(收集)
#!homepage= https://github.com/dcpengx/Loon/tree/main/plugin/Q-search
#!icon= https://gitlab.com/lodepuly/iconlibrary/-/raw/main/App_icon/120px/Safari.png
#!homepage = https://github.com/Tartarus2014/Loon-Script
#!system = iOS,iPadOS
#!system_version = 15
#!tag = 功能增强
#!date= 2026-8-14 

##################################################################################################
# - Safari 内输入以下格式命令快速指定搜索引擎
# - 【命令+空格+关键词】或者【关键词+空格+命令】
# - 注：请先进入设置更改 Safari 默认搜索为 DuckDuckGO
# - 更新时间：2025-2-14
# - 转自墨鱼-> https://t.me/ddgksf2021 
# - 图标来自 可莉 仓库 https://gitlab.com/lodepuly/vpn_tool/-/blob/master/README.md
# - 收集：秦城二院彭医生
##################################################################################################

[Rewrite]
#>>>>>>>>>>>>>>>>>>>>>>>翻译
# yd  xxx (有道词典)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=yd\+([^&]+).+/i as urlMatch then redirect(302, "http://dict.youdao.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+yd.+/i as urlMatch then redirect(302, "http://dict.youdao.com/search?q=${urlMatch.1}")

# trc xxx (Google 译至中)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=trc\+([^&]+).+/i as urlMatch then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=zh-CN&text=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+trc.+/i as urlMatch then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=zh-CN&text=${urlMatch.1}")

# tre xxx (Google 译至英)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=tre\+([^&]+).+/i as urlMatch then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=en&text=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+tre.+/i as urlMatch then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=en&text=${urlMatch.1}")

# trj xxx (Google 译至日)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=trj\+([^&]+).+/i as urlMatch then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=ja&text=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+trj.+/i as urlMatch then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=ja&text=${urlMatch.1}")

#>>>>>>>>>>>>>>>>>>>>>>>社区
# tt    xxx (头条)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=tt\+([^&]+).+/i as urlMatch then redirect(302, "https://so.toutiao.com/search?keyword=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+tt.+/i as urlMatch then redirect(302, "https://so.toutiao.com/search?keyword=${urlMatch.1}")

# db    xxx (豆瓣)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=db\+([^&]+).+/i as urlMatch then redirect(302, "https://m.douban.com/search?query=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+db.+/i as urlMatch then redirect(302, "https://m.douban.com/search?query=${urlMatch.1}")

# zh    xxx (知乎)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=zh\+([^&]+).+/i as urlMatch then redirect(302, "http://www.zhihu.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+zh.+/i as urlMatch then redirect(302, "http://www.zhihu.com/search?q=${urlMatch.1}")

# wb    xxx (微博)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=wb\+([^&]+).+/i as urlMatch then redirect(302, "https://s.weibo.com/weibo/${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+wb.+/i as urlMatch then redirect(302, "https://s.weibo.com/weibo/${urlMatch.1}")

# wx    xxx (微信)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=wx\+([^&]+).+/i as urlMatch then redirect(302, "https://weixin.sogou.com/weixinwap?query=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+wx.+/i as urlMatch then redirect(302, "https://weixin.sogou.com/weixinwap?query=${urlMatch.1}")

# up xxx (Unsplash)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=up\+([^&]+).+/i as urlMatch then redirect(302, "https://unsplash.com/s/photos/${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+up.+/i as urlMatch then redirect(302, "https://unsplash.com/s/photos/${urlMatch.1}")

# sspai xxx (少数派站内搜索)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=sspai\+([^&]+).+/i as urlMatch then redirect(302, "https://sspai.com/search/post/${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+sspai.+/i as urlMatch then redirect(302, "https://sspai.com/search/post/${urlMatch.1}")

# ssp   xxx (Google 搜索少数派)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=ssp\+([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?as_q=${urlMatch.1}&as_sitesearch=sspai.com")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+ssp.+/i as urlMatch then redirect(302, "https://www.google.com/search?as_q=${urlMatch.1}&as_sitesearch=sspai.com")

# tw    xxx (Twitter)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=tw\+([^&]+).+/i as urlMatch then redirect(302, "https://twitter.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+tw.+/i as urlMatch then redirect(302, "https://twitter.com/search?q=${urlMatch.1}")

# gh    xxx (GitHub)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=gh\+([^&]+).+/i as urlMatch then redirect(302, "https://github.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+gh.+/i as urlMatch then redirect(302, "https://github.com/search?q=${urlMatch.1}")

# so    xxx (Stack Overflow)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=so\+([^&]+).+/i as urlMatch then redirect(302, "https://stackoverflow.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+so.+/i as urlMatch then redirect(302, "https://stackoverflow.com/search?q=${urlMatch.1}")

# se    xxx (StackExchange)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=se\+([^&]+).+/i as urlMatch then redirect(302, "https://stackexchange.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+se.+/i as urlMatch then redirect(302, "https://stackexchange.com/search?q=${urlMatch.1}")

# wa    xxx (WolframAlpha)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=wa\+([^&]+).+/i as urlMatch then redirect(302, "https://www.wolframalpha.com/input/?i=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+wa.+/i as urlMatch then redirect(302, "https://www.wolframalpha.com/input/?i=${urlMatch.1}")

# rd    xxx (Reddit)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=rd\+([^&]+).+/i as urlMatch then redirect(302, "https://www.reddit.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+rd.+/i as urlMatch then redirect(302, "https://www.reddit.com/search?q=${urlMatch.1}")

#>>>>>>>>>>>>>>>>>>>>>>>购物
# zdm xxx (什么值得买)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=zdm\+([^&]+).+/i as urlMatch then redirect(302, "https://search.m.smzdm.com/?v=b&s=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+zdm.+/i as urlMatch then redirect(302, "https://search.m.smzdm.com/?v=b&s=${urlMatch.1}")

# jd  xxx (京东)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=jd\+([^&]+).+/i as urlMatch then redirect(302, "openapp.jdmobile://virtual?params={\"des\":\"productList\",\"keyWord\":\"${urlMatch.1}\",\"from\":\"search\",\"category\":\"jump\"}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+jd.+/i as urlMatch then redirect(302, "openapp.jdmobile://virtual?params={\"des\":\"productList\",\"keyWord\":\"${urlMatch.1}\",\"from\":\"search\",\"category\":\"jump\"}")

# tb  xxx (淘宝)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=tb\+([^&]+).+/i as urlMatch then redirect(302, "taobao://s.taobao.com?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+tb.+/i as urlMatch then redirect(302, "taobao://s.taobao.com?q=${urlMatch.1}")

#>>>>>>>>>>>>>>>>>>>>>>>视频
# yt  xxx (YouTube)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=yt\+([^&]+).+/i as urlMatch then redirect(302, "https://www.youtube.com/results?search_query=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+yt.+/i as urlMatch then redirect(302, "https://www.youtube.com/results?search_query=${urlMatch.1}")

# bli xxx (哔哩哔哩)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=bli\+([^&]+).+/i as urlMatch then redirect(302, "https://m.bilibili.com/search?keyword=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+bli.+/i as urlMatch then redirect(302, "https://m.bilibili.com/search?keyword=${urlMatch.1}")

# gd  xxx (Google 搜索 Google Drive 资源)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=gd\+([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?q=%22Google+Drive%22+${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+gd.+/i as urlMatch then redirect(302, "https://www.google.com/search?q=%22Google+Drive%22+${urlMatch.1}")

# tgd xxx (t.me/gdurl 搜索 Google Drive 资源)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=tgd\+([^&]+).+/i as urlMatch then redirect(302, "https://t.me/s/gdurl?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+tgd.+/i as urlMatch then redirect(302, "https://t.me/s/gdurl?q=${urlMatch.1}")

# ph  xxx (PornHub)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=ph\+([^&]+).+/i as urlMatch then redirect(302, "https://cn.pornhub.com/video/search?search=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+ph.+/i as urlMatch then redirect(302, "https://cn.pornhub.com/video/search?search=${urlMatch.1}")

# af  xxx (Acfun)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=af\+([^&]+).+/i as urlMatch then redirect(302, "https://www.acfun.cn/search?keyword=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+af.+/i as urlMatch then redirect(302, "https://www.acfun.cn/search?keyword=${urlMatch.1}")

# ys  xxx (搜片)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=ys\+([^&]+).+/i as urlMatch then redirect(302, "https://soupian.icu/search?key=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+ys.+/i as urlMatch then redirect(302, "https://soupian.icu/search?key=${urlMatch.1}")

#>>>>>>>>>>>>>>>>>>>>>>>苹果商店切换
#源链接爬虫于>>https://www.liangjianghu.com/searchads-appstore-switch
#Created by ddgksf2013，使用方法：输入区号，搜索即可
# cn  (切换至中国区)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=cn&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143465&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=cn&urlDesc=")
# hk  (切换至香港区)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=hk&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143463&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=hk&urlDesc=")
# tw  (切换至台湾区)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=tw&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143470&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=tw&urlDesc=")
# us  (切换至美国区)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=us&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143441&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=us&urlDesc=")
# jp  (切换至日本区)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=jp&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143462&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=jp&urlDesc=")
# kr  (切换至韩国区)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=kr&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143466&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=kr&urlDesc=")
# tr  (切换至土耳其区)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=tr&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143480&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=tr&urlDesc=")
# sg  (切换至新加坡区)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=sg&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143464&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=tr&urlDesc=")


#>>>>>>>>>>>>>>>>>>>>>>>搜索

# bd  xxx (百度搜索)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=bd\+([^&]+).+/i as urlMatch then redirect(302, "https://www.baidu.com/s?wd=${urlMatch.1}%20-adclear")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=((.(?!bd))+)\+bd.+/i as urlMatch then redirect(302, "https://www.baidu.com/s?wd=${urlMatch.1}%20-adclear")

# wk  xxx (维基搜索)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=wk\+([^&]+).+/i as urlMatch then redirect(302, "https://zh.wikipedia.org/wiki/${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+wk.+/i as urlMatch then redirect(302, "https://zh.wikipedia.org/wiki/${urlMatch.1}")

# wz  xxx (无追搜索)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=wz\+([^&]+).+/i as urlMatch then redirect(302, "https://www.wuzhuiso.com/s?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+wz.+/i as urlMatch then redirect(302, "https://www.wuzhuiso.com/s?q=${urlMatch.1}")

# yh  xxx (油猴搜索)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=yh\+([^&]+).+/i as urlMatch then redirect(302, "https://greasyfork.org/zh-CN/scripts?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+yh.+/i as urlMatch then redirect(302, "https://greasyfork.org/zh-CN/scripts?q=${urlMatch.1}")

# gi  xxx (Google 图片)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=gi\+([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?&tbm=isch&q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+gi.+/i as urlMatch then redirect(302, "https://www.google.com/search?&tbm=isch&q=${urlMatch.1}")

# by  xxx (必应)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=by\+([^&]+).+/i as urlMatch then redirect(302, "https://www.bing.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+by.+/i as urlMatch then redirect(302, "https://www.bing.com/search?q=${urlMatch.1}")

# ios  xxx (苹果应用搜索)
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=ios\+([^&]+).+/i as urlMatch then redirect(302, "https://www.qimai.cn/search/index/search/${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+ios.+/i as urlMatch then redirect(302, "https://www.qimai.cn/search/index/search/${urlMatch.1}")

#     xxx （无指令默认为 Google）
# 默认 Google 搜索：排除 Q-search 指令
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=(?!(?:cn|hk|tw|us|jp|kr|tr|sg)&)(?!(?:yd|trc|tre|trj|tt|db|zh|wb|wx|up|sspai|ssp|tw|gh|so|se|wa|rd|zdm|jd|tb|yt|bli|gd|tgd|ph|af|ys|bd|wk|wz|yh|gi|by|ios)\+)(?![^&]+\+(?:yd|trc|tre|trj|tt|db|zh|wb|wx|up|sspai|ssp|tw|gh|so|se|wa|rd|zdm|jd|tb|yt|bli|gd|tgd|ph|af|ys|bd|wk|wz|yh|gi|by|ios)(?:&|$))([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?q=${urlMatch.1}")

[Mitm]
hostname = duckduckgo.com