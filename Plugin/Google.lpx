#!name = 谷歌搜索重定向
#!desc = Google搜索中国、香港、日本重定向
#!author = Tartarus
#!system = iOS,iPadOS,tvOS,macOS
#!loon_version = 3.5.1(984)
#!homepage = https://github.com/Tartarus2014/Loon-Script
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google.png

[Rewrite]
request if ${url} ~= /^https?:\/\/www\.google\.(?:cn|co\.jp|com\.hk)(?:\/(.*))?$/i as urlMatch then redirect(302, "https://www.google.com/${urlMatch.1}")

[MITM]
hostname = *.google.com.hk, *.google.cn, *.google.co.jp