[Rewrite]
request if ${url} ~= /^https?:\/\/api-dc-prod-\d+\.cyou\// then reject
request if ${url} ~= /^https?:\/\/api-dc2-prod-\d+\.cyou\// then reject
request if ${url} ~= /^https?:\/\/.*\.eqfx9bas\.cc\// then reject
request if ${url} ~= /^https?:\/\/.*\.yihaici\.(?:top|com)\// then reject
request if ${url} ~= /^https?:\/\/.*\.epuf3tk\.cc\// then reject
request if ${url} ~= /^https?:\/\/[^\/]+\/upload_01\/ads\// then reject

[Script]
request if ${url} ~= /^https?:\/\/.*\.00po\.shop\/api\/app\/vid\/m3u8\/.*/i then script("https://raw.githubusercontent.com/Tartarus2014/Loon-Script/refs/heads/master/JS/lys.js")

request if ${url} ~= /^https?:\/\/.*\.00po\.shop\/.*/i then script("https://raw.githubusercontent.com/Tartarus2014/Loon-Script/refs/heads/master/JS/lysad.js")

response if ${url} ~= /^https?:\/\/.*\.00po\.shop\/.*/i then script("https://raw.githubusercontent.com/Tartarus2014/Loon-Script/refs/heads/master/JS/lysad.js") with requires_body=true

[MITM]
hostname = oihawlma.00po.shop, *.00po.shop, *.oukky-lys.shop, *.cyou, *.eqfx9bas.cc, *.yihaici.top, *.yihaici.com, *.epuf3tk.cc, *.hxscwine.com, *.wdyzdc.com