[Mitm]
# 提醒passphrase和p12代为证书&主机名部分, 更新配置前可把旧的配置中passphrase和p12代码拷贝下来, 导入新的配置文件把内容粘贴在对应位置就不用重装证书
ca-p12 = 
ca-passphrase = 
skip-server-cert-verify = false
hostname = 
